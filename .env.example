# Copy this file to .env and fill in your own values. Never commit .env.

# Free API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gmail account that sends the alert. Needs 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords (16 letters, no spaces).
GMAIL_USER=your.name@gmail.com
GMAIL_APP_PASSWORD=your-16-letter-app-password
# Who gets the alert. Several addresses: separate with commas.
ALERT_TO=your.name@gmail.com
